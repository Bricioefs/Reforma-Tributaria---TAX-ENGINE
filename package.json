{
  "name": "tax-engine-ibs-cbs",
  "version": "0.1.0",
  "description": "Motor tributário IBS/CBS/IS baseado na LC 214/2025 (EC 132/2023) - Fase 1",
  "bin": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn src/main.ts",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "build:exe": "npm run build && pkg . --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --output dist-exe/tax-engine"
  },
  "pkg": {
    "assets": [
      "dist/public/**",
      "dist/assets/**",
      "node_modules/xlsx-chart/template/**"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^5.19.0",
    "decimal.js": "^10.4.3",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5",
    "xlsx-chart": "^0.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/jszip": "^3.4.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "pkg": "^5.8.1",
    "prisma": "^5.19.0",
    "ts-jest": "^29.2.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
